{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "OathLight",
  "version": "0.1.0",
  "identifier": "com.oathlight.desktop",
  "build": {
    "frontendDist": "../src/renderer",
    "beforeDevCommand": "node scripts/bundle-sidecars.mjs",
    "beforeBuildCommand": "node scripts/bundle-sidecars.mjs"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "licenseFile": "../installer/EULA.rtf",
    "externalBin": [
      "binaries/oathlightguard",
      "binaries/oath-light-host"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "perMachine"
      }
    }
  }
}
