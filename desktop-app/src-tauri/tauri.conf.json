{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "PurePath",
  "version": "0.1.0",
  "identifier": "com.purepath.desktop",
  "build": {
    "frontendDist": "../src/renderer",
    "beforeDevCommand": "node scripts/bundle-sidecars.mjs",
    "beforeBuildCommand": "node scripts/bundle-sidecars.mjs"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Pure Path",
        "width": 1024,
        "height": 720,
        "minWidth": 820,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/purepathguard",
      "binaries/pure-path-host"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
