{
  "manifest_version": 3,
  "name": "Pure Path - Content Filter",
  "version": "3.5.0",
  "description": "A content filtering system to help you stay focused on personal growth",
  "key": "",
  "browser_specific_settings": {
    "gecko": {
      "id": "purepath@xeno-legit.github.io",
      "strict_min_version": "109.0"
    }
  },
  "permissions": [
    "storage",
    "tabs",
    "webNavigation",
    "nativeMessaging",
    "cookies",
    "unlimitedStorage",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": [
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "blocked.html",
        "graylist-inject.js",
        "blocklists/domains_part1.json",
        "blocklists/domains_part2.json",
        "blocklists/domains_part3.json",
        "icons/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}