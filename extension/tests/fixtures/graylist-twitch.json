  "captured_channel_page": {
    "_why": "VERBATIM capture of the operation that carries the labels on a real channel page (twitch.tv/jynxzi), pulled from the ~30-operation batch the client POSTs on load. Two things here are load-bearing and were both wrong when this fixture was invented rather than captured: (1) the top level is an ARRAY of operations, not a single object; (2) the user in THIS operation has `displayName` and NO `login`, which is why ownerOf() has to accept displayName — keying on login alone made the page-block silently never fire. The label here is MatureGame, so this payload must NOT block.",
    "batch": [
      {
        "data": {
          "user": {
            "id": "411377640",
            "stream": {
              "id": "317775505752",
              "game": { "id": "460630", "name": "Rainbow Six Siege", "__typename": "Game" },
              "contentClassificationLabels": [
                { "id": "MatureGame", "localizedName": "Mature-rated game", "__typename": "ContentClassificationLabel" }
              ],
              "contentClassificationLabelPolicyProperties": {
                "signPostProperties": { "signPost": "SIGN_POST_NOT_REQUIRED", "contentClassificationLabels": [], "__typename": "ContentClassificationLabelPolicySignPostProperties" },
                "contentGateProperties": { "contentGate": "CONTENT_GATE_NOT_REQUIRED", "__typename": "ContentClassificationLabelPolicyContentGateProperties" },
                "__typename": "ContentClassificationLabelPolicyProperties"
              },
              "__typename": "Stream"
            },
            "displayName": "Jynxzi",
            "__typename": "User"
          }
        },
        "extensions": { "durationMilliseconds": 62, "operationName": "ContentClassificationContext", "requestID": "01KYX0F9JKQWY985EQCTWSKWPB" }
      }
    ]
  },

